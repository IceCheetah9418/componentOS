# LLM Provider Configuration
# Options: ollama, openrouter, openai, custom
LLM_PROVIDER=openrouter
LLM_API_KEY=your_openrouter_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=cohere/north-mini-code:free
PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Authentication
# Set a strong API key for request authentication
API_KEY=your-secure-api-key-here-change-in-production

# Optional: Ollama configuration (if using local models)
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=codellama
